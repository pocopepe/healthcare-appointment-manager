# Copy this file to `.dev.vars` for local development (wrangler reads .dev.vars, not .env).
# In production, set each of these with: wrangler secret put <NAME>

# --- App ---
# wrangler.jsonc's top-level `vars.APP_BASE_URL` is the production value;
# this overrides it for local dev only (.dev.vars wins over wrangler.jsonc vars).
APP_BASE_URL=http://localhost:5173

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string

# --- LLM (pre-visit / post-visit summaries) ---
# Set LLM_PROVIDER to "anthropic" or "openai". Leave the matching key blank to
# run with LLM summaries disabled (the app degrades gracefully, see src/server/lib/llm.ts).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Email (SendGrid HTTP API) ---
# Leave blank to run with email delivery disabled (notifications are logged, not sent).
SENDGRID_API_KEY=
EMAIL_FROM=appointments@example.com

# --- Google Calendar (OAuth 2.0) ---
# Leave blank to run with calendar sync disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/calendar/oauth/callback
