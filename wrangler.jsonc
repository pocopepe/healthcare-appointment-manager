{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "healthcare-appointment-manager",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "healthcare-appointment-manager-db",
      "database_id": "3a8e7f7c-2bd7-4522-be70-cb3a2b110e7e",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "APP_BASE_URL": "https://healthcare-appointment-manager.avijusanjai.workers.dev",
    // Must match an Authorized redirect URI on the Google OAuth client
    // exactly, or Google rejects the flow with redirect_uri_mismatch.
    "GOOGLE_REDIRECT_URI": "https://healthcare-appointment-manager.avijusanjai.workers.dev/api/calendar/oauth/callback",
    "LLM_PROVIDER": "workers-ai",
    // Self-imposed daily cap on LLM calls, kept well under Workers AI's
    // free 10,000 Neurons/day (a summary costs roughly 15-25 Neurons).
    "LLM_DAILY_LIMIT": "200"
  }
}
